<?xml version="1.0" encoding="UTF-8"?>
<!--
  W05 · Spring IOC / DI

  ⚠️ 状态：**未验证**。本机没有 Maven（也没有 Gradle），这四天的编译和运行全部是
     run.sh / run.bat 里那两行 javac + java（classpath = out;lib/*）。
     这个 pom 是「结账」用的：把 lib/ 里手工放的 7 个 jar 写成声明，让工程可迁移。

  装好 Maven 之后第一件事，不是直接信它，而是做一次对撞：
      mvn -q clean compile
      mvn -q exec:java -Dexec.mainClass=com.newt.java48.w05.day5.BoardCheck
      ./run.sh day5.BoardCheck
  两条路都必须打出 23 / 23 条通过、exit=0。**对不上就说明这份 pom 有问题，别当它是对的。**

  lib/ 里 7 个 jar 与下列声明的关系：
    spring-context   → 传递依赖带进 core / beans / expression / aop / jcl（共 6 个）
    javax.annotation-api → 显式依赖（JDK 11+ 已把 @PostConstruct 移出 JDK，Spring 5 用 javax，不是 jakarta）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.newt.java48</groupId>
    <artifactId>w05-spring-ioc-di</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>W05 · Spring IOC / DI</name>
    <description>Bean 对象图 / 生命周期 / 作用域 / 注入取舍 —— 四天四个入口 + 一个封板自检</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <spring.version>5.3.39</spring.version>
    </properties>

    <dependencies>
        <!-- 一个坐标带进 6 个 jar：core / beans / context / expression / aop / spring-jcl -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
        </dependency>

        <!-- @PostConstruct / @PreDestroy / @Resource。Spring 5 用 javax.*（Spring 6 才是 jakarta.*） -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                    <!--
                      默认不加 -parameters：Day 4 E 段要证明的正是「没有它，构造器参数名只剩 arg0」。
                      想复现「加了就能按参数名回退」，把下面这行注释打开再编译。
                    -->
                    <!-- <compilerArgs><arg>-parameters</arg></compilerArgs> -->
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.newt.java48.w05.day5.BoardCheck</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
